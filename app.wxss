page {
  box-sizing: border-box;
  min-height: 100%;
  background: #f6f7fb;
  color: #1e2433;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view, text, button, input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 190rpx;
}

.card {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(40, 46, 76, 0.06);
}

.section-title {
  margin: 36rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #8d93a5;
  font-size: 20rpx;
}
