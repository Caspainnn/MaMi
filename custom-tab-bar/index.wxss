.tabbar { position:fixed; right:0; bottom:0; left:0; z-index:99; border-top:1rpx solid #eef0f5; background:rgba(255,255,255,.98); box-shadow:0 -8rpx 24rpx rgba(39,42,75,.04); }.tabbar-safe { display:flex; padding:18rpx 14rpx calc(18rpx + env(safe-area-inset-bottom)); }.tab-item { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; min-width:0; color:#9297a8; }.tab-icon { height:46rpx; color:inherit; font-size:42rpx; font-weight:500; line-height:46rpx; }.tab-icon-2 { font-size:50rpx; transform:translateY(-1rpx); }.tab-text { color:inherit; font-size:24rpx; line-height:1.2; }.tab-active { color:#5b5bff; }.tab-active .tab-icon { font-weight:800; }
