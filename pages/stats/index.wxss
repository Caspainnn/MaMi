.overview { padding:40rpx 34rpx; background:linear-gradient(135deg,#f0f0ff,#fff); }.caption,.sub,.metric-label { display:block; color:#8990a3; font-size:24rpx; }.big { display:block; margin:16rpx 0 12rpx; font-size:42rpx; font-weight:700; }.week,.metrics { display:flex; justify-content:space-around; padding:30rpx 18rpx; }.day { display:flex; flex-direction:column; align-items:center; gap:14rpx; color:#858c9e; font-size:23rpx; }.dot { width:34rpx; height:34rpx; border-radius:50%; background:#eceef5; }.dot.active { background:#22c55e; }.metrics > view { display:flex; flex-direction:column; align-items:center; }.metric { font-size:38rpx; font-weight:700; }.metric-label { margin-top:8rpx; }
