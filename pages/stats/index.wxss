.overview { padding:40rpx 34rpx; background:linear-gradient(135deg,#f0f0ff,#fff); }.caption,.sub,.metric-label { display:block; color:#8990a3; font-size:24rpx; }.big { display:block; margin:16rpx 0 24rpx; color:#292946; font-size:40rpx; font-weight:700; }.plan-progress { overflow:hidden; height:18rpx; border-radius:12rpx; background:#e4e4f1; }.plan-progress-fill { height:100%; border-radius:12rpx; background:linear-gradient(90deg,#5b5bff,#a46bff); }.progress-text { display:block; margin-top:12rpx; color:#5b5bff; font-size:28rpx; font-weight:800; text-align:right; }.metrics { display:flex; justify-content:space-around; padding:30rpx 18rpx; }.metrics > view { display:flex; flex-direction:column; align-items:center; }.metric { color:#292946; font-size:38rpx; font-weight:700; }.metric-label { margin-top:8rpx; }.calendar { padding:28rpx 24rpx; }.calendar-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; color:#4d4d69; font-size:26rpx; font-weight:700; }.calendar-head text:last-child { color:#9aa0b0; font-size:20rpx; font-weight:400; }.weekday-row,.calendar-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:12rpx; }.weekday-row { margin-bottom:12rpx; color:#9aa0b0; font-size:21rpx; text-align:center; }.calendar-cell { display:flex; justify-content:center; }.calendar-square { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; border-radius:10rpx; color:#758096; background:#fff; font-size:20rpx; }.checkin-full { color:#fff; background:#15803d; }.checkin-partial { color:#166534; background:#86efac; }.checkin-none { border:2rpx solid #edf0f3; box-sizing:border-box; }.calendar-blank { visibility:hidden; }.calendar-legend { display:flex; justify-content:flex-end; gap:18rpx; margin-top:24rpx; color:#7f8597; font-size:20rpx; }.calendar-legend view { display:flex; align-items:center; gap:6rpx; }.legend-dot { width:14rpx; height:14rpx; border-radius:4rpx; }.legend-full { background:#15803d; }.legend-partial { background:#86efac; }.legend-none { border:2rpx solid #dfe3e8; box-sizing:border-box; }.levels { padding:34rpx 26rpx; }.ring-chart { position:relative; width:280rpx; height:280rpx; margin:6rpx auto 38rpx; border-radius:50%; }.ring-center { position:absolute; top:52rpx; left:52rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; width:176rpx; height:176rpx; border-radius:50%; color:#4d4d69; background:#fff; box-shadow:0 4rpx 18rpx rgba(31,36,64,.08); }.ring-center text:first-child { color:#292946; font-size:44rpx; font-weight:800; }.ring-center text:last-child { margin-top:6rpx; color:#8990a3; font-size:23rpx; }.level-list { display:flex; flex-direction:column; gap:20rpx; }.level-row { display:flex; align-items:center; gap:14rpx; }.level-dot { flex:none; width:16rpx; height:16rpx; border-radius:50%; }.level-name { width:48rpx; color:#4d4d69; font-size:25rpx; font-weight:700; }.level-track { flex:1; overflow:hidden; height:14rpx; border-radius:8rpx; background:#ececf3; }.level-fill { height:100%; border-radius:8rpx; }.level-count { width:116rpx; color:#7f8597; font-size:22rpx; text-align:right; }
.experience { padding:30rpx 26rpx; }.experience-head,.experience-section-head,.draft-actions,.experience-footer,.syntax-top { display:flex; align-items:center; justify-content:space-between; }.experience-title { display:block; color:#292946; font-size:30rpx; font-weight:700; }.experience-hint { display:block; width:410rpx; margin-top:8rpx; color:#8990a3; font-size:21rpx; line-height:1.45; }.refine-button { flex:none; width:166rpx; height:62rpx; margin:0; padding:0; border:1rpx solid #6764ff; border-radius:31rpx; color:#5755ec; background:#fff; font-size:22rpx; line-height:60rpx; }.experience-draft { box-sizing:border-box; width:100%; height:150rpx; margin-top:26rpx; padding:20rpx; border:1rpx solid #e7e8f0; border-radius:14rpx; color:#34344f; background:#fafaff; font-size:25rpx; line-height:1.55; }.draft-actions { margin-top:10rpx; color:#9aa0b0; font-size:20rpx; }.text-button,.add-card,.remove-card { margin:0; padding:0; border:0; color:#625ff0; background:transparent; font-size:22rpx; line-height:1.4; }.experience-section { margin-top:30rpx; }.experience-section-head { padding-bottom:14rpx; color:#34344f; font-size:28rpx; font-weight:700; }.experience-empty { padding:24rpx 18rpx; border-radius:12rpx; color:#969bad; background:#fafaff; font-size:23rpx; }.experience-card { margin-top:14rpx; padding:18rpx; border:1rpx solid #ececf4; border-radius:14rpx; background:#fff; }.experience-card input { box-sizing:border-box; width:100%; min-height:52rpx; padding:8rpx 0; color:#41415c; font-size:24rpx; }.thinking-card { display:flex; align-items:center; gap:16rpx; }.thinking-card input { flex:1; }.remove-card { flex:none; color:#a2a4b2; }.syntax-top { gap:16rpx; }.syntax-language { width:140rpx !important; color:#625ff0 !important; font-size:22rpx !important; }.syntax-code { margin-top:8rpx; padding:12rpx !important; border-radius:10rpx; color:#5c5f74 !important; background:#f6f6fb; font-family:monospace; font-size:22rpx !important; }.experience-footer { gap:16rpx; margin-top:30rpx; }.save-cards,.undo-button { flex:1; height:66rpx; margin:0; padding:0; border-radius:33rpx; font-size:23rpx; line-height:66rpx; }.save-cards { color:#fff; background:#5b5bff; }.undo-button { border:1rpx solid #b6b8c6; color:#72778a; background:#fff; }
