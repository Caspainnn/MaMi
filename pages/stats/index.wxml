<view class="page">
  <view class="overview card"><block wx:if="{{plan}}"><text class="caption">当前计划</text><text class="big">{{plan.questionBankName}}斩杀计划</text><view class="plan-progress"><view class="plan-progress-fill" style="width:{{progressPercent}}%"></view></view><text class="progress-text">{{progressPercent}}%</text></block><block wx:else><text class="caption">当前还未创建计划</text><text class="big">从第一题开始</text><text class="sub">创建计划后，这里将展示你的学习进度。</text></block></view>
  <view class="section-title">本月打卡</view><view class="calendar card"><view class="calendar-head"><text>{{monthTitle}}</text><text>完整 / 部分 / 未打卡</text></view><view class="weekday-row"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view class="calendar-cell {{item.blank ? 'calendar-blank' : ''}}" wx:for="{{calendarDays}}" wx:key="key"><view class="calendar-square checkin-{{item.checkinState}}"><text wx:if="{{!item.blank}}">{{item.day}}</text></view></view></view><view class="calendar-legend"><view><text class="legend-dot legend-full"></text>完整</view><view><text class="legend-dot legend-partial"></text>部分</view><view><text class="legend-dot legend-none"></text>未打卡</view></view></view>
  <view class="section-title">累计数据</view><view class="metrics card"><view><text class="metric">{{totalPracticeCount}}</text><text class="metric-label">刷题次数</text></view><view><text class="metric">{{streak}}</text><text class="metric-label">连续打卡</text></view><view><text class="metric">{{slashedCount}}</text><text class="metric-label">斩杀题目</text></view></view>
  <block wx:if="{{plan}}"><view class="section-title">掌握等级</view><view class="levels card"><view class="ring-chart" style="{{ringStyle}}"><view class="ring-center"><text>{{plan.totalProblems}}</text><text>总题数</text></view></view><view class="level-list"><view class="level-row" wx:for="{{levelCounts}}" wx:key="level"><view class="level-dot" style="background:{{item.color}}"></view><text class="level-name">{{item.level}}</text><view class="level-track"><view class="level-fill" style="width:{{item.percent}}%;background:{{item.color}}"></view></view><text class="level-count">{{item.count}} 题 · {{item.percent}}%</text></view></view></view></block>
</view>
