.detail-page { min-height:100vh; padding:24rpx 0 260rpx; background:#fff; }
.top-nav { display:flex; align-items:center; gap:16rpx; padding:0 32rpx 28rpx; }
.bank-switcher { display:flex; flex:1; align-items:center; justify-content:flex-start; min-width:0; height:72rpx; padding:0 26rpx; border-radius:36rpx; color:#333; background:#f5f5f7; font-size:27rpx; font-weight:500; overflow:hidden; }
.problem-switcher { display:flex; align-items:center; gap:10rpx; }.switch-btn { display:flex; align-items:center; justify-content:center; width:62rpx; height:62rpx; border-radius:50%; color:#5b5bff; background:#eeeefe; font-size:50rpx; font-family:serif; line-height:1; }.switch-disabled { color:#c9cbd8; background:#f3f4f7; }
.slash-btn { display:flex; align-items:center; justify-content:center; width:76rpx; height:54rpx; border:3rpx solid #5b5bff; border-radius:30rpx; color:#5b5bff; background:#fff; font-size:27rpx; font-weight:600; }
.problem-header { padding:12rpx 48rpx 0; }
.problem-title { display:block; margin-bottom:26rpx; color:#1a1a1a; font-size:58rpx; font-weight:700; line-height:1.25; }
.tags-row { display:flex; gap:16rpx; margin-bottom:32rpx; }.tag { padding:10rpx 22rpx; border-radius:30rpx; font-size:24rpx; font-weight:500; }.tag-stage { color:#2563eb; background:#dbeafe; }.tag-difficulty { color:#16a34a; background:#dcfce7; }
.tabs { display:flex; gap:18rpx; }.tab { padding:16rpx 30rpx; border:3rpx solid #5b5bff; border-radius:38rpx; color:#5b5bff; background:#fff; font-size:28rpx; font-weight:500; }.tab-active { color:#fff; background:#5b5bff; }
.problem-description { padding:44rpx 48rpx 0; color:#333; font-size:30rpx; line-height:1.8; }.description-copy { display:block; margin-top:30rpx; color:#555; }.tag-list { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:36rpx; }.inline-tag { padding:8rpx 18rpx; border-radius:24rpx; color:#676c7e; background:#f3f4f7; font-size:23rpx; }
.records-empty { display:flex; flex-direction:column; align-items:center; padding-top:130rpx; color:#697086; font-size:30rpx; }.records-icon { margin-bottom:18rpx; color:#5b5bff; font-size:60rpx; }.records-hint { margin-top:12rpx; color:#9aa0ae; font-size:25rpx; }
.records-panel { padding-top:36rpx; }.record-list { padding:0 32rpx 90rpx; }.record-expanded-list { padding-bottom:270rpx; }.record-card { box-sizing:border-box; margin-bottom:24rpx; padding:30rpx; border-radius:28rpx; color:#fff; box-shadow:0 14rpx 28rpx rgba(73,77,152,.14); }.record-card-no_idea { background:linear-gradient(135deg,#737784,#959ba8); }.record-card-some_idea { background:linear-gradient(135deg,#8883df,#aaa6ef); }.record-card-almost { background:linear-gradient(135deg,#5b5bff,#7c7cff); }.record-card-independent { color:#4a3100; background:linear-gradient(135deg,#fcd34d,#fbbf24); }.record-card-independent .record-summary,.record-card-independent .code-preview-head,.record-card-independent .code-content { color:rgba(74,49,0,.9); }.record-card-independent .record-date { color:rgba(74,49,0,.82); }.record-card-independent .code-preview { background:rgba(255,255,255,.42); }.record-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:18rpx; }.record-status { font-size:38rpx; font-weight:700; }.record-date { flex-shrink:0; font-size:25rpx; opacity:.88; }.record-summary { display:-webkit-box; overflow:hidden; color:rgba(255,255,255,.96); font-size:27rpx; line-height:1.65; -webkit-box-orient:vertical; -webkit-line-clamp:3; }.record-card-expanded { margin-bottom:32rpx; }.record-summary-full { display:block; margin-bottom:26rpx; }.code-preview { padding:22rpx; border-radius:18rpx; background:rgba(255,255,255,.16); }.code-preview-head { display:flex; justify-content:space-between; margin-bottom:14rpx; color:rgba(255,255,255,.95); font-size:24rpx; }.code-content { display:block; overflow:auto; max-height:420rpx; color:#fff; font-family:monospace; font-size:22rpx; line-height:1.55; white-space:pre-wrap; word-break:break-all; }.other-records-title { display:block; margin:6rpx 0 20rpx; color:#4a5061; font-size:28rpx; font-weight:600; }.record-card-mini { padding:24rpx 30rpx; opacity:.78; }.record-card-mini .record-head { margin:0; }.record-card-mini .record-status { font-size:30rpx; }.collapse-link { margin:10rpx auto 24rpx; color:#5b5bff; font-size:28rpx; text-align:center; }
.bottom-actions { position:fixed; right:0; bottom:0; left:0; display:flex; gap:18rpx; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:#fff; box-shadow:0 -10rpx 34rpx rgba(31,36,64,.08); }.primary-action,.secondary-action { display:flex; flex:1; align-items:center; justify-content:center; width:auto; height:84rpx; padding:0 12rpx; border-radius:46rpx; font-size:27rpx; font-weight:600; line-height:1; white-space:nowrap; }.primary-action::after,.secondary-action::after { border:0; }.primary-action { color:#fff; background:#5b5bff; }.secondary-action { color:#5b5bff; border:3rpx solid #5b5bff; background:#fff; }
