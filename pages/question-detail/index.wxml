<view class="detail-page" wx:if="{{problem}}">
  <view class="top-nav">
    <view class="bank-switcher">
      <text>{{bankName}}</text>
    </view>
    <view class="problem-switcher">
      <view class="switch-btn {{!canPrev ? 'switch-disabled' : ''}}" bindtap="previousProblem">‹</view>
      <view class="switch-btn {{!canNext ? 'switch-disabled' : ''}}" bindtap="nextProblem">›</view>
    </view>
    <view class="slash-btn" bindtap="slayProblem">斩</view>
  </view>

  <view class="problem-header">
    <text class="problem-title">{{problem.title}}</text>
    <view class="tags-row">
      <text class="tag tag-stage">一破</text>
      <text class="tag tag-difficulty">{{problem.difficulty}}</text>
    </view>
    <view class="tabs">
      <view class="tab {{activeTab === 'description' ? 'tab-active' : ''}}" bindtap="selectTab" data-tab="description">题目描述</view>
      <view class="tab {{activeTab === 'records' ? 'tab-active' : ''}}" bindtap="selectTab" data-tab="records">提交记录</view>
    </view>
  </view>

  <view class="problem-description" wx:if="{{activeTab === 'description'}}">
    <text>{{problem.summary}}</text>
    <text class="description-copy">题目来源于当前计划绑定题库。完成外部平台练习后，可返回码秘记录本次回忆表现与耗时。</text>
    <view class="tag-list">
      <text class="inline-tag" wx:for="{{problem.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="records-empty" wx:else>
    <text class="records-icon">○</text>
    <text>暂无提交记录</text>
    <text class="records-hint">完成练习后，记录会显示在这里。</text>
  </view>

  <view class="bottom-actions">
    <button class="primary-action" bindtap="copyLink">复制题目链接</button>
    <button class="secondary-action" bindtap="startPractice">提交刷题记录</button>
  </view>
</view>
