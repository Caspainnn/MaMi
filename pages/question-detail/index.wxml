<view class="detail-page detail-loading" wx:if="{{loading}}"><view class="loading-spinner"></view><text>正在加载题目...</text></view>
<view class="detail-page detail-loading" wx:elif="{{loadError}}"><text class="load-error">题目加载失败</text><button class="retry-button" bindtap="retryLoad">重新加载</button></view>
<view class="detail-page" wx:else>
  <view class="top-nav">
    <view class="bank-switcher"><text>{{bankName}}</text></view>
    <view class="problem-switcher">
      <view class="switch-btn {{!canPrev ? 'switch-disabled' : ''}}" bindtap="previousProblem"><text class="switch-arrow">‹</text></view>
      <view class="switch-btn {{!canNext ? 'switch-disabled' : ''}}" bindtap="nextProblem"><text class="switch-arrow">›</text></view>
    </view>
    <view class="slash-btn" bindtap="slayProblem">斩杀</view>
  </view>

  <view class="problem-header">
    <text class="problem-title">{{problem.title}}</text>
    <view class="tags-row"><text class="tag tag-stage">{{problem.level || 'Lv0'}}</text><text class="tag tag-difficulty">{{problem.difficulty}}</text></view>
    <view class="tabs">
      <view class="tab {{activeTab === 'description' ? 'tab-active' : ''}}" bindtap="selectTab" data-tab="description">题目描述</view>
      <view class="tab {{activeTab === 'records' ? 'tab-active' : ''}}" bindtap="selectTab" data-tab="records">提交记录</view>
    </view>
  </view>

  <view class="problem-description" wx:if="{{activeTab === 'description'}}">
    <text>{{problem.summary}}</text>
    <text class="description-copy">完成外部练习后，在码秘记录本次表现。</text>
    <view class="tag-list"><text class="inline-tag" wx:for="{{problem.tags}}" wx:key="*this">{{item}}</text></view>
  </view>

  <view class="records-panel" wx:else>
    <view wx:if="{{expandedRecordId}}" class="record-list record-expanded-list">
      <block wx:for="{{records}}" wx:key="id">
        <view wx:if="{{item.id === expandedRecordId}}" class="record-card record-card-{{item.recallType}} record-card-expanded">
          <view class="record-head"><text class="record-status">{{item.recallResult}}</text><text class="record-date">{{item.submittedAt}}</text></view>
          <text class="record-summary record-summary-full">{{item.summary || '未提交'}}</text>
          <view class="code-preview">
            <view class="code-preview-head"><text>代码</text><text>{{item.duration}}</text></view>
            <text class="code-content">{{item.code || '未提交'}}</text>
          </view>
        </view>
      </block>
      <view class="collapse-link" bindtap="collapseRecords">收起详情</view>
      <text class="other-records-title" wx:if="{{records.length > 1}}">其他历史记录</text>
      <block wx:for="{{records}}" wx:key="id">
        <view wx:if="{{item.id !== expandedRecordId}}" class="record-card record-card-{{item.recallType}} record-card-mini" bindtap="expandRecord" data-id="{{item.id}}">
          <view class="record-head"><text class="record-status">{{item.recallResult}}</text><text class="record-date">{{item.submittedAt}}</text></view>
        </view>
      </block>
    </view>

    <view wx:else class="record-list">
      <view class="record-card record-card-{{item.recallType}}" wx:for="{{records}}" wx:key="id" bindtap="expandRecord" data-id="{{item.id}}">
        <view class="record-head"><text class="record-status">{{item.recallResult}}</text><text class="record-date">{{item.submittedAt}}</text></view>
        <text class="record-summary">{{item.summary || '未提交'}}</text>
      </view>
    </view>

    <view class="records-empty" wx:if="{{!records.length && !recordsLoading}}"><text class="records-icon">○</text><text>暂无提交记录</text><text class="records-hint">完成练习后，记录会显示在这里。</text></view>
  </view>

  <view class="bottom-actions"><button class="primary-action" bindtap="copyLink">复制题目链接</button><button class="secondary-action" bindtap="startPractice">提交刷题记录</button></view>
</view>
