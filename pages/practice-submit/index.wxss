.page { min-height:100vh; padding:28rpx 28rpx 170rpx; box-sizing:border-box; background:#f6f7fb; }
.problem { padding:28rpx; }
.problem-title,.problem-meta,.section-title,.option-label,.option-hint { display:block; }
.problem-title { color:#25263d; font-size:36rpx; font-weight:700; }
.problem-meta { margin-top:12rpx; color:#8b90a4; font-size:25rpx; }
.section { margin-top:30rpx; }
.section-title { margin-bottom:16rpx; color:#303148; font-size:30rpx; font-weight:700; }
.option { margin-bottom:14rpx; padding:22rpx 24rpx; border:3rpx solid transparent; border-radius:20rpx; color:#52566b; background:#fff; }
.option.selected { border-color:#4b4bce; color:#fff; background:linear-gradient(135deg,#5b5bff,#8585ff); }
.option-label { font-size:29rpx; font-weight:700; }
.option-hint { margin-top:8rpx; font-size:23rpx; line-height:1.45; }
.duration-list { display:flex; flex-wrap:wrap; gap:14rpx; }
.duration { padding:16rpx 22rpx; border-radius:18rpx; color:#606579; background:#fff; font-size:26rpx; }
.duration.selected { color:#fff; background:#5b5bff; }
.field-head { display:flex; align-items:baseline; justify-content:space-between; }
.field-head text:last-child { color:#9298a8; font-size:23rpx; }
textarea { width:100%; min-height:160rpx; padding:22rpx; border-radius:18rpx; box-sizing:border-box; color:#303148; background:#fff; font-size:27rpx; }
.summary-section { position:relative; }
.summary-section textarea { padding-bottom:86rpx; }
.ai-generate { position:absolute; right:18rpx; bottom:16rpx; display:flex; align-items:center; justify-content:center; width:20%; height:56rpx; border:2rpx solid #5b5bff; border-radius:28rpx; color:#4b46d8; background:rgba(255,255,255,.86); box-shadow:0 6rpx 14rpx rgba(59,55,168,.1); font-size:20rpx; font-weight:600; line-height:1; }
.ai-generating { opacity:.6; }
.submit { position:fixed; right:28rpx; bottom:30rpx; left:28rpx; border-radius:48rpx; color:#fff; background:#5b5bff; font-size:30rpx; }
.success-mask { position:fixed; z-index:10; inset:0; display:flex; align-items:center; justify-content:center; padding:48rpx; background:rgba(25,25,52,.58); }
.success-modal { width:100%; padding:56rpx 42rpx 42rpx; border-radius:36rpx; box-sizing:border-box; background:linear-gradient(145deg,#fff,#f2f0ff); box-shadow:0 26rpx 70rpx rgba(16,14,57,.3); text-align:center; }
.success-emoji,.success-title,.success-caption,.success-hint { display:block; }
.success-emoji { margin-bottom:16rpx; color:#f2b01e; font-size:74rpx; line-height:1; }
.success-title { color:#292849; font-size:42rpx; font-weight:800; }
.success-caption { margin-top:42rpx; color:#838198; font-size:25rpx; }
.level-change { display:flex; align-items:center; justify-content:center; gap:28rpx; margin:16rpx 0 24rpx; color:#8b88a5; font-size:38rpx; font-weight:700; }
.level-arrow { color:#5b5bff; font-size:42rpx; }
.level-after { color:#5b5bff; font-size:62rpx; font-weight:800; }
.success-hint { min-height:40rpx; color:#5d5a73; font-size:27rpx; }
.success-button { width:100%; margin-top:44rpx; border-radius:48rpx; color:#fff; background:#5b5bff; font-size:30rpx; }
