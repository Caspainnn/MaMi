.page { min-height:100vh; padding:36rpx 32rpx 190rpx; background:#f6f7fb; box-sizing:border-box; }.steps { display:flex; justify-content:center; gap:14rpx; margin:12rpx 0 58rpx; }.step { width:18rpx; height:18rpx; border-radius:12rpx; background:#dfe1ed; }.step.active { width:54rpx; background:#5b5bff; }.heading { margin-bottom:32rpx; }.title,.subtitle,.goal-name,.goal-desc,.estimate-title,.validation,.estimate-hint { display:block; }.title { color:#20213a; font-size:48rpx; font-weight:700; }.subtitle { margin-top:14rpx; color:#8b90a4; font-size:26rpx; }.goal-card { margin-bottom:22rpx; padding:30rpx; border:3rpx solid transparent; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#5b5bff,#8585ff); box-shadow:0 14rpx 30rpx rgba(91,91,255,.16); }.goal-card.selected { border-color:#e29b13; background:linear-gradient(135deg,#ffb736,#ffcf65); box-shadow:0 14rpx 30rpx rgba(255,183,54,.24); }.goal-name { font-size:36rpx; font-weight:700; }.goal-desc { margin-top:12rpx; font-size:25rpx; opacity:.9; }.input-row { display:flex; align-items:center; gap:16rpx; margin-top:26rpx; padding:18rpx 20rpx; border-radius:16rpx; color:#333; background:#fff; }.input-row input { flex:1; min-width:0; font-size:30rpx; }.input-row text { color:#777; font-size:26rpx; }.validation { margin-top:16rpx; color:#d45b3f; font-size:24rpx; line-height:1.5; }.estimate { margin-top:30rpx; padding:28rpx; border-radius:24rpx; color:#4b4c66; background:#fff; }.estimate-title { margin-bottom:18rpx; color:#25263d; font-size:30rpx; font-weight:700; }.estimate view { display:flex; justify-content:space-between; gap:24rpx; padding:16rpx 0; border-top:1rpx solid #eef0f5; font-size:26rpx; }.estimate view text:last-child { color:#5b5bff; text-align:right; }.estimate-hint { margin-top:18rpx; color:#8b90a4; font-size:22rpx; line-height:1.5; }.submit { position:fixed; z-index:10; right:32rpx; bottom:32rpx; left:32rpx; margin:0; border-radius:52rpx; color:#fff; background:#5b5bff; font-size:30rpx; }.submit.disabled { color:#a6aaba; background:#e3e5ed; }
.review-limit { margin:28rpx 0 0; padding:28rpx; }.review-limit-title,.review-limit-copy,.review-limit-hint { display:block; }.review-limit-title { color:#292a42; font-size:30rpx; font-weight:700; }.review-limit-copy { margin-top:10rpx; color:#858aa0; font-size:23rpx; line-height:1.5; }.review-limit-options { display:flex; gap:12rpx; margin-top:24rpx; }.review-limit-option { flex:1; padding:15rpx 0; border:2rpx solid #e4e6ef; border-radius:14rpx; color:#74798e; font-size:24rpx; text-align:center; }.review-limit-option.selected { border-color:#5b5bff; color:#fff; background:#5b5bff; }.review-limit-hint { min-height:32rpx; margin-top:16rpx; color:#8a8ed2; font-size:22rpx; line-height:1.5; }
