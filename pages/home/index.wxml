<view class="page">
  <view class="hero card">
    <text class="eyebrow">{{today}} · 从今天开始</text>
    <text class="hero-title">像背单词一样<br/>刷算法题</text>
    <text class="hero-copy">建立计划、记录回忆、长期掌握。</text>
    <button class="hero-button" bindtap="createPlan">创建我的斩杀计划</button>
  </view>

  <view class="section-head"><text class="section-title">今日新刷</text><text class="muted">按题库顺序</text></view>
  <view class="task-list" wx:if="{{newProblems.length}}">
    <view class="task card" wx:for="{{newProblems}}" wx:key="id" bindtap="openProblem" data-id="{{item.id}}">
      <view class="task-index">{{index + 1}}</view>
      <view class="task-info"><text class="task-title">{{item.title}}</text><text class="task-meta">{{item.category}} · {{item.difficulty}}</text></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-head"><text class="section-title">今日复刷</text><text class="muted">漏刷优先</text></view>
  <view class="empty card" wx:if="{{!reviewProblems.length}}"><text class="empty-icon">✓</text><text>暂无到期复习，保持这个节奏！</text></view>
</view>
