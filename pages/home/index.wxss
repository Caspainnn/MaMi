.hero { padding: 42rpx 36rpx; color: #fff; background: linear-gradient(135deg, #5B5BFF, #8585FF); }
.eyebrow { display: block; opacity: .78; font-size: 24rpx; }
.hero-plan-row { display:flex; align-items:center; justify-content:space-between; gap:24rpx; }.hero-plan-main { flex:1; min-width:0; }.hero-title { display: block; margin-top: 18rpx; font-size: 48rpx; line-height: 1.28; font-weight: 700; }
.hero-copy { display: block; margin: 18rpx 0 30rpx; font-size: 26rpx; opacity: .86; }.streak { display:flex; flex-direction:column; align-items:center; justify-content:center; flex:none; min-width:118rpx; padding:12rpx 10rpx; border-radius:22rpx; background:rgba(255,255,255,.16); transition:all .2s; }.streak-checked { color:#5b3600; background:linear-gradient(145deg,#ffe68a,#fbbf24); box-shadow:0 8rpx 18rpx rgba(251,191,36,.38); }.streak-value { display:block; font-size:58rpx; font-weight:800; line-height:1; }.streak-label { display:block; margin-top:8rpx; font-size:20rpx; opacity:.9; }
.hero-button { height:84rpx; margin:0; padding:0 38rpx; border-radius:42rpx; color:#5B5BFF; background:#fff; font-size:27rpx; font-weight:600; line-height:84rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-head .section-title { margin-bottom: 20rpx; }
.task-list { display: flex; flex-direction: column; gap: 16rpx; }
.task-toggle { margin:22rpx auto 6rpx; padding:10rpx 18rpx; color:#7176d9; font-size:24rpx; line-height:1.2; text-align:center; }
.task { display: flex; align-items: center; padding: 24rpx; }.task-completed { opacity:.62; background:#f1f2f5; }
.task-index { width: 48rpx; height: 48rpx; border-radius: 50%; text-align: center; line-height: 48rpx; color: #5B5BFF; background: #eeeeff; font-weight: 700; }
.task-info { flex: 1; margin-left: 20rpx; }.task-title, .task-meta { display:block; }.task-title { font-size: 30rpx; font-weight: 600; }.task-meta { margin-top: 8rpx; font-size: 24rpx; color:#8d93a5; }.task-completed .task-index { color:#fff; background:#5b5bff; }.review-task .task-index { width:auto; min-width:62rpx; padding:0 8rpx; box-sizing:border-box; color:#5b5bff; background:#eeeeff; font-size:21rpx; }.review-task.task-completed .task-index { width:48rpx; min-width:48rpx; padding:0; color:#fff; background:#5b5bff; font-size:32rpx; }.arrow { font-size:48rpx; color:#aeb3c2; }
.empty { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; padding:34rpx 28rpx; color:#697086; font-size:26rpx; }.empty-icon { color:#22c55e; font-size:34rpx; font-weight:700; }
.login-mask { position:fixed; z-index:100; right:0; bottom:0; left:0; display:flex; align-items:flex-end; min-height:100vh; padding:0 24rpx calc(150rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:rgba(25,26,48,.38); }.login-sheet { width:100%; padding:38rpx 34rpx 32rpx; border-radius:30rpx; box-sizing:border-box; background:#fff; box-shadow:0 -12rpx 42rpx rgba(29,30,68,.14); }.login-title,.login-copy { display:block; }.login-title { color:#343454; font-size:33rpx; font-weight:700; }.login-copy { margin-top:16rpx; color:#878ca0; font-size:24rpx; line-height:1.55; }.login-actions { display:flex; align-items:center; gap:20rpx; margin-top:34rpx; }.login-defer { flex:1; padding:22rpx 0; color:#84899a; font-size:27rpx; text-align:center; }.login-confirm { flex:2; margin:0; border-radius:48rpx; color:#fff; background:#5b5bff; font-size:28rpx; line-height:82rpx; }
