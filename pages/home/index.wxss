.hero { padding: 42rpx 36rpx; color: #fff; background: linear-gradient(135deg, #5B5BFF, #8585FF); }
.eyebrow { display: block; opacity: .78; font-size: 24rpx; }
.hero-title { display: block; margin-top: 18rpx; font-size: 48rpx; line-height: 1.28; font-weight: 700; }
.hero-copy { display: block; margin: 18rpx 0 30rpx; font-size: 26rpx; opacity: .86; }
.hero-button { margin: 0; padding: 0 30rpx; border-radius: 40rpx; color: #5B5BFF; background: #fff; font-size: 26rpx; font-weight: 600; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-head .section-title { margin-bottom: 20rpx; }
.task-list { display: flex; flex-direction: column; gap: 16rpx; }
.task { display: flex; align-items: center; padding: 24rpx; }
.task-index { width: 48rpx; height: 48rpx; border-radius: 50%; text-align: center; line-height: 48rpx; color: #5B5BFF; background: #eeeeff; font-weight: 700; }
.task-info { flex: 1; margin-left: 20rpx; }.task-title, .task-meta { display:block; }.task-title { font-size: 30rpx; font-weight: 600; }.task-meta { margin-top: 8rpx; font-size: 24rpx; color:#8d93a5; }.arrow { font-size:48rpx; color:#aeb3c2; }
.empty { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; padding:34rpx 28rpx; color:#697086; font-size:26rpx; }.empty-icon { color:#22c55e; font-size:34rpx; font-weight:700; }
