<view class="page"><block wx:if="{{needsPlan && !loading}}"><view class="no-plan card"><text class="no-plan-title">还没有启用计划</text><text>创建计划后，题库页会自动展示该计划绑定的题库。</text><button bindtap="createPlan">创建计划</button></view></block><block wx:else><view class="current-bank card"><text class="bank-label">当前题库</text><text class="bank-name">{{currentBank.name}}</text><text class="bank-count">{{currentBank.count}} 道 · 题库切换请前往“我的 - 斩杀计划”</text></view><view class="search card"><text>⌕</text><input placeholder="搜索题目名称" value="{{keyword}}" bindinput="search" /></view><scroll-view class="categories" scroll-x><view class="category {{activeCategory === item ? 'category-active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="chooseCategory" data-name="{{item}}">{{item}}</view></scroll-view><view class="problem-count">共 {{displayedProblems.length}} 题</view><view class="problem card" wx:for="{{displayedProblems}}" wx:key="id" bindtap="openProblem" data-id="{{item.id}}"><view class="problem-main"><view class="level-dot level-{{item.levelClass}}"></view><view class="problem-text"><text class="problem-title">{{item.title}}</text><text class="problem-category">{{item.category}}</text></view></view><view class="problem-side"><text class="difficulty difficulty-{{item.difficultyClass}}">{{item.difficulty}}</text></view></view><view class="empty" wx:if="{{!displayedProblems.length && !loading}}">未找到匹配题目</view></block></view>
