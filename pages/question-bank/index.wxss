.categories { white-space: nowrap; margin: 14rpx -28rpx 24rpx; padding: 0 28rpx; }.current-bank { display:flex; flex-direction:column; margin-bottom:24rpx; padding:26rpx 28rpx; }.bank-label,.bank-count { color:#8c93a5; font-size:22rpx; }.bank-name { margin:10rpx 0 8rpx; color:#292b43; font-size:32rpx; font-weight:700; }.category { display:inline-flex; margin-right:16rpx; padding:13rpx 24rpx; border-radius:20rpx; background:#fff; color:#6f7688; font-size:25rpx; }.category-active { color:#fff; background:#5B5BFF; }.search { display:flex; align-items:center; gap:16rpx; padding:22rpx 24rpx; color:#8c93a5; }.search input { flex:1; font-size:28rpx; }.problem-count { margin:10rpx 0 16rpx; color:#8c93a5; font-size:24rpx; }.problem { display:flex; justify-content:space-between; align-items:center; padding:24rpx; margin-bottom:16rpx; }.problem-main { display:flex; flex:1; align-items:center; min-width:0; gap:16rpx; }.problem-text { flex:1; min-width:0; }.problem-title,.problem-category { display:block; }.problem-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:30rpx; font-weight:600; }.problem-category { margin-top:8rpx; color:#9aa0b0; font-size:22rpx; }.problem-side { display:flex; align-items:center; margin-left:20rpx; }.level-dot { flex:none; width:20rpx; height:20rpx; border-radius:50%; }.level-lv0 { background:#6B7A8F; }.level-lv1 { background:#94A3B8; }.level-lv2 { background:#60A5FA; }.level-lv3 { background:#22D3EE; }.level-lv4 { background:#C084FC; }.level-lv5 { background:#FBBF24; }.difficulty { padding:8rpx 14rpx; border-radius:12rpx; font-size:22rpx; }.difficulty-easy { color:#159947; background:#e9faef; }.difficulty-medium { color:#bd7b05; background:#fff6df; }.difficulty-hard { color:#df3f3f; background:#fff0f0; }.empty { margin-top:80rpx; text-align:center; color:#9aa0b0; }.no-plan { display:flex; flex-direction:column; align-items:flex-start; gap:18rpx; margin-top:24rpx; padding:38rpx 32rpx; color:#73788b; font-size:27rpx; line-height:1.5; }.no-plan-title { color:#25263d; font-size:36rpx; font-weight:700; }.no-plan button { margin:8rpx 0 0; border-radius:40rpx; color:#fff; background:#5b5bff; font-size:26rpx; }
