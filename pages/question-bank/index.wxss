.categories { white-space: nowrap; margin: 4rpx -28rpx 24rpx; padding: 0 28rpx; }.current-bank { display:flex; flex-direction:column; margin-bottom:24rpx; padding:26rpx 28rpx; }.bank-label,.bank-count { color:#8c93a5; font-size:22rpx; }.bank-name { margin:10rpx 0 8rpx; color:#292b43; font-size:32rpx; font-weight:700; }.category { display:inline-flex; margin-right:16rpx; padding:13rpx 24rpx; border-radius:20rpx; background:#fff; color:#6f7688; font-size:25rpx; }.category-active { color:#fff; background:#5B5BFF; }.search { display:flex; align-items:center; gap:16rpx; padding:22rpx 24rpx; color:#8c93a5; }.search input { flex:1; font-size:28rpx; }.problem-count { margin:10rpx 0 16rpx; color:#8c93a5; font-size:24rpx; }.problem { display:flex; justify-content:space-between; align-items:center; padding:24rpx; margin-bottom:16rpx; }.problem-main { display:grid; grid-template-columns:auto 1fr; column-gap:12rpx; }.problem-number,.problem-category { color:#9aa0b0; font-size:22rpx; }.problem-title { font-size:30rpx; font-weight:600; }.problem-category { grid-column:2; margin-top:8rpx; }.difficulty { padding:8rpx 14rpx; border-radius:12rpx; font-size:22rpx; }.difficulty-easy { color:#159947; background:#e9faef; }.difficulty-medium { color:#bd7b05; background:#fff6df; }.difficulty-hard { color:#df3f3f; background:#fff0f0; }.empty { margin-top:80rpx; text-align:center; color:#9aa0b0; }
