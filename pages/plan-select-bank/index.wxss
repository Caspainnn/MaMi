.page { min-height:100vh; padding:36rpx 32rpx 190rpx; background:#f6f7fb; box-sizing:border-box; }.steps { display:flex; justify-content:center; gap:14rpx; margin:12rpx 0 58rpx; }.step { width:18rpx; height:18rpx; border-radius:12rpx; background:#dfe1ed; }.step.active { width:54rpx; background:#5b5bff; }.heading { margin-bottom:32rpx; }.title,.subtitle { display:block; }.title { color:#20213a; font-size:48rpx; font-weight:700; }.subtitle { margin-top:14rpx; color:#8b90a4; font-size:26rpx; }.bank-card { display:flex; align-items:center; min-height:190rpx; margin-bottom:22rpx; padding:30rpx; border:3rpx solid transparent; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#5b5bff,#8585ff); box-shadow:0 14rpx 30rpx rgba(91,91,255,.16); }.bank-card.selected { border-color:#e29b13; background:linear-gradient(135deg,#ffb736,#ffcf65); box-shadow:0 14rpx 30rpx rgba(255,183,54,.24); }.bank-name,.bank-desc,.bank-count { display:block; }.bank-name { font-size:36rpx; font-weight:700; }.bank-desc { max-width:500rpx; margin-top:12rpx; font-size:25rpx; line-height:1.5; opacity:.9; }.bank-count { margin-top:12rpx; font-size:23rpx; opacity:.78; }.next { position:fixed; z-index:10; right:32rpx; bottom:32rpx; left:32rpx; margin:0; border-radius:52rpx; color:#fff; background:#5b5bff; font-size:30rpx; }.next.disabled { color:#a6aaba; background:#e3e5ed; }.loading,.empty { padding:80rpx 0; color:#8b90a4; text-align:center; }
