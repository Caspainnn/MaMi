<view class="page">
  <view class="steps"><view class="step active"></view><view class="step"></view></view>
  <view class="heading"><text class="title">选择题库</text><text class="subtitle">一个计划只绑定一套题库</text></view>
  <view class="bank-list" wx:if="{{!loading}}">
    <view class="bank-card {{selectedCode === item.code ? 'selected' : ''}}" wx:for="{{banks}}" wx:key="code" bindtap="chooseBank" data-code="{{item.code}}">
      <view><text class="bank-name">{{item.name}}</text><text class="bank-desc">{{item.description}}</text><text class="bank-count">共 {{item.count}} 道题</text></view>
    </view>
    <view class="empty" wx:if="{{!banks.length}}">暂无可选择的云端题库</view>
  </view>
  <view class="loading" wx:if="{{loading}}">正在读取云端题库…</view>
  <button class="next {{!selectedCode ? 'disabled' : ''}}" bindtap="continueSetup" disabled="{{!selectedCode}}">选好了，下一步</button>
</view>
