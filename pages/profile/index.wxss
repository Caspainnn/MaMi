.user { display:flex; align-items:center; gap:22rpx; padding:32rpx; }.avatar { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:50%; color:#fff; background:#5b5bff; font-size:38rpx; font-weight:700; }.name,.hint { display:block; }.name { font-size:34rpx; font-weight:700; }.hint { margin-top:8rpx; color:#9298a8; font-size:24rpx; }.plan { margin-top:24rpx; padding:34rpx; color:#fff; background:linear-gradient(135deg,#282848,#5b5bff); }.plan-label,.plan-title,.plan-meta { display:block; }.plan-label { font-size:24rpx; opacity:.72; }.plan-title { margin:16rpx 0 10rpx; font-size:32rpx; font-weight:600; }.plan-meta { margin-bottom:24rpx; font-size:24rpx; opacity:.82; }.plan button { margin:0; border-radius:40rpx; color:#4f4fff; background:#fff; font-size:26rpx; }.plan-actions { display:flex; gap:18rpx; }.plan-actions button { flex:1; }.plan-actions .secondary { color:#fff; border:1rpx solid rgba(255,255,255,.7); background:transparent; }.menu { margin-top:24rpx; padding:0 28rpx; }.menu view { display:flex; justify-content:space-between; padding:28rpx 0; border-bottom:1rpx solid #f0f1f5; font-size:29rpx; }.menu view:last-child { border:0; }.muted { font-size:24rpx; }
