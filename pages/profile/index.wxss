.user { display:flex; align-items:center; gap:22rpx; padding:32rpx; }.avatar { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:50%; color:#fff; background:#5b5bff; font-size:38rpx; font-weight:700; }.name { display:block; margin-top:16rpx; font-size:34rpx; font-weight:700; }.plan { margin-top:24rpx; padding:34rpx; color:#fff; background:linear-gradient(135deg,#282848,#5b5bff); }.plan-label,.plan-title,.plan-meta { display:block; }.plan-label { font-size:24rpx; opacity:.72; }.plan-title { margin:16rpx 0 10rpx; font-size:32rpx; font-weight:600; }.plan-meta { margin-bottom:24rpx; font-size:24rpx; opacity:.82; }.plan button { margin:0; border-radius:40rpx; color:#4f4fff; background:#fff; font-size:26rpx; }.plan-actions { display:flex; gap:18rpx; }.plan-actions button { flex:1; }.plan-actions .secondary { color:#fff; border:1rpx solid rgba(255,255,255,.7); background:transparent; }.menu { margin-top:24rpx; padding:0 28rpx; }.menu view { display:flex; justify-content:space-between; padding:28rpx 0; border-bottom:1rpx solid #f0f1f5; font-size:29rpx; }.menu view:last-child { border:0; }.muted { font-size:24rpx; }
.feedback { margin-top:24rpx; padding:30rpx; }.feedback-head { display:flex; align-items:center; justify-content:space-between; }.feedback-title,.feedback-hint { display:block; }.feedback-title { color:#343454; font-size:31rpx; font-weight:700; }.feedback-hint { margin-top:9rpx; color:#9298a8; font-size:23rpx; }.feedback-arrow { padding:8rpx 4rpx 8rpx 24rpx; color:#8186a0; font-size:42rpx; line-height:1; }.feedback-body { padding-top:26rpx; }.feedback-label { display:block; color:#62677c; font-size:24rpx; }.feedback-categories { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:16rpx; }.feedback-category { padding:12rpx 18rpx; border:2rpx solid #e4e6ef; border-radius:28rpx; color:#73788d; font-size:23rpx; line-height:1; }.feedback-category-selected { border-color:#5b5bff; color:#5b5bff; background:#f1efff; }.feedback-input { width:100%; min-height:190rpx; margin-top:24rpx; padding:20rpx; box-sizing:border-box; border-radius:18rpx; color:#41425a; background:#f7f7fb; font-size:26rpx; line-height:1.55; }.feedback-placeholder { color:#b0b4c3; }.feedback-foot { display:flex; align-items:center; justify-content:space-between; margin-top:16rpx; }.feedback-count { color:#a4a8b7; font-size:22rpx; }.feedback-submit { margin:0; padding:0 28rpx; border-radius:30rpx; color:#fff; background:#5b5bff; font-size:24rpx; line-height:62rpx; }
