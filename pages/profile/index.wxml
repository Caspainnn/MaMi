<view class="page"><view class="user card"><view class="avatar">M</view><view><text class="name">{{user.nickname}}</text></view></view><view class="plan card"><text class="plan-label">我的斩杀计划</text><block wx:if="{{activePlan}}"><text class="plan-title">{{activePlan.questionBankName}}</text><text class="plan-meta">预计完成：{{activePlan.estimatedFinishDate}}</text><view class="plan-actions"><button class="secondary" bindtap="resetPlan">重置计划</button><button bindtap="createPlan">新建计划</button></view></block><block wx:else><text class="plan-title">还没有计划，开始你的第一题</text><button bindtap="createPlan">创建计划</button></block></view><view class="feedback card"><view class="feedback-head" bindtap="toggleFeedback"><view><text class="feedback-title">码秘，我有话对你说…</text><text class="feedback-hint">你的建议会帮助码秘变得更好。</text></view><text class="feedback-arrow">{{feedbackExpanded ? '⌃' : '›'}}</text></view><view wx:if="{{feedbackExpanded}}" class="feedback-body"><text class="feedback-label">你想反馈什么？</text><view class="feedback-categories"><view wx:for="{{feedbackCategories}}" wx:key="key" class="feedback-category {{feedbackCategory === item.key ? 'feedback-category-selected' : ''}}" data-category="{{item.key}}" bindtap="selectFeedbackCategory">{{item.label}}</view></view><textarea class="feedback-input" value="{{feedback}}" maxlength="500" placeholder="可以是想新增的功能、使用时的不便，或任何想说的话。" placeholder-class="feedback-placeholder" bindinput="onFeedbackInput"/><view class="feedback-foot"><text class="feedback-count">{{feedback.length}} / 500</text><button class="feedback-submit" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}" bindtap="submitFeedback">提交建议</button></view></view></view></view>
