<view class="page"><view class="user card"><view class="avatar">M</view><view><text class="name">{{user.nickname}}</text><text class="hint">微信云开发身份已连接</text></view></view><view class="plan card"><text class="plan-label">我的斩杀计划</text><block wx:if="{{activePlan}}"><text class="plan-title">{{activePlan.questionBankName}}</text><text class="plan-meta">预计完成：{{activePlan.estimatedFinishDate}}</text><view class="plan-actions"><button class="secondary" bindtap="resetPlan">重置计划</button><button bindtap="createPlan">新建计划</button></view></block><block wx:else><text class="plan-title">还没有计划，开始你的第一题</text><button bindtap="createPlan">创建计划</button></block></view><view class="menu card"><view><text>累计刷题</text><text class="muted">{{user.totalPractices || 0}} 题</text></view><view><text>连续打卡</text><text class="muted">{{user.streak || 0}} 天</text></view></view></view>
