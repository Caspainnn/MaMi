.hero { padding:38rpx 34rpx; background:linear-gradient(135deg,#f0f0ff,#fff); }.caption,.hero-copy { display:block; color:#8990a3; font-size:24rpx; }.hero-title { display:block; margin:16rpx 0 10rpx; color:#292946; font-size:42rpx; font-weight:800; }.library { margin-top:28rpx; padding:32rpx 28rpx; }.library-top { display:flex; align-items:center; justify-content:space-between; color:#292946; }.library-title-wrap { display:flex; flex-direction:column; gap:5rpx; }.library-title { font-size:32rpx; font-weight:800; }.cloud-saved { color:#9297a8; font-size:20rpx; font-weight:400; }.action-row { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; }.append-button,.undo-icon { display:flex; align-items:center; justify-content:center; box-sizing:border-box; height:56rpx; border-radius:28rpx; background:#fff; }.append-button { width:108rpx; border:2rpx solid #5b5bff; color:#4b46d8; font-size:20rpx; font-weight:600; letter-spacing:0; }.append-loading { opacity:.6; }.undo-icon { width:56rpx; border:2rpx solid #db5a65; color:#d9485a; font-size:34rpx; line-height:1; transform:translateY(-1rpx); }.doc-section { margin-top:30rpx; }.doc-title { display:block; margin:0 0 14rpx; color:#3e4053; font-size:29rpx; font-weight:700; }.markdown-doc { min-height:210rpx; padding:18rpx 20rpx; border:1rpx solid #dddfea; border-radius:16rpx; background:#fcfcff; }.markdown-read { min-height:174rpx; }.markdown-editor { width:100%; min-height:320rpx; padding:0; color:#34364b; background:transparent; font-size:27rpx; line-height:1.65; }.syntax-editor { min-height:400rpx; font-family:monospace; font-size:24rpx; }.empty-hint { display:block; padding-top:58rpx; color:#a0a4b3; font-size:25rpx; text-align:center; }.library-foot { margin-top:22rpx; color:#9a9eae; font-size:21rpx; }.empty { margin-top:28rpx; padding:40rpx 28rpx; color:#8990a3; font-size:26rpx; text-align:center; }.notice-mask { position:fixed; z-index:999; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:56rpx; background:rgba(25,28,45,.44); }.notice-dialog { width:100%; padding:38rpx 32rpx 28rpx; border-radius:26rpx; background:#fff; box-shadow:0 18rpx 50rpx rgba(15,18,40,.2); }.notice-title { display:block; color:#292946; font-size:34rpx; font-weight:800; text-align:center; }.letter-greeting { display:block; margin-top:26rpx; color:#4a4e62; font-size:26rpx; line-height:1.7; text-align:left; }.notice-content { display:block; margin-top:14rpx; color:#5d6275; font-size:26rpx; line-height:1.75; white-space:pre-line; }.letter-signature { display:block; margin-top:20rpx; color:#62677c; font-size:24rpx; text-align:right; }.notice-confirm { display:flex; align-items:center; justify-content:center; height:72rpx; margin-top:34rpx; border-radius:36rpx; color:#fff; background:#5b5bff; font-size:26rpx; font-weight:700; }
